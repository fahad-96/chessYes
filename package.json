{
  "name": "chess-yes",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source chess game review. Stockfish runs in your browser: move classifications, accuracy, eval graph and plain-English explanations.",
  "license": "GPL-3.0-or-later",
  "author": "Fahad (https://github.com/fahad-96)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahad-96/kibitz-chess.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openings": "node scripts/build-openings.mjs",
    "engine": "node scripts/copy-engine.mjs",
    "voice:clips": "node scripts/voice-clips.mjs",
    "voice:fetch": "node scripts/fetch-voice.mjs",
    "postinstall": "node scripts/copy-engine.mjs && node scripts/fetch-voice.mjs",
    "predev": "node scripts/copy-engine.mjs && node scripts/fetch-voice.mjs",
    "prebuild": "node scripts/copy-engine.mjs && node scripts/fetch-voice.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stockfish": "^19.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
